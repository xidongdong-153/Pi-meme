{
  "name": "@pi-meme/file-directory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "浏览当前项目目录，预览文本文件。",
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsx ../../packages/plugin-devkit/src/cli.ts build .",
    "validate": "tsx ../../packages/plugin-devkit/src/cli.ts validate .",
    "pack": "tsx ../../packages/plugin-devkit/src/cli.ts pack . dist/plugin.pim"
  },
  "devDependencies": {
    "@pi-meme/plugin-devkit": "workspace:*",
    "@pi-meme/plugin-sdk": "workspace:*",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "@types/react": "^19.3.0"
  },
  "piMeme": {
    "sdkVersion": 2,
    "display": {
      "name": "文件目录"
    },
    "ui": "dist/ui/entry.js"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "dependencies": {
    "@pi-meme/contracts": "workspace:*"
  }
}
