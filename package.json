{
  "name": "pi-meme-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "pnpm --filter pi-meme start",
    "package": "pnpm --filter pi-meme package",
    "make": "pnpm --filter pi-meme make",
    "package:host": "node --import tsx scripts/package-host.mts",
    "lint": "eslint .",
    "type-check": "pnpm -r type-check && tsc --noEmit -p tsconfig.tests.json",
    "format": "prettier --check .",
    "check-boundaries": "node scripts/check-package-boundaries.mjs",
    "start:server": "pnpm --filter @pi-meme/server start",
    "start:web": "pnpm --filter @pi-meme/web dev",
    "build:web": "pnpm --filter @pi-meme/web build",
    "build:server": "pnpm --filter @pi-meme/server build",
    "postinstall": "node scripts/prepare-node-pty.mjs",
    "test": "node --import tsx scripts/test.mts",
    "test:all": "pnpm test --all"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@pi-meme/pi-runtime": "workspace:*",
    "@pi-meme/plugin-devkit": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "29.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "@pi-meme/host": "workspace:*",
    "@pi-meme/contracts": "workspace:*"
  }
}
